{
  "name": "zenith",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "start": "node backend/server.cjs",
    "dev": "node --watch backend/server.cjs",
    "test:server": "node --test tests/server.test.cjs",
    "db:setup": "pwsh -NoProfile -File backend/scripts/postgres-local.ps1 -Action setup",
    "db:start": "pwsh -NoProfile -File backend/scripts/postgres-local.ps1 -Action start",
    "db:stop": "pwsh -NoProfile -File backend/scripts/postgres-local.ps1 -Action stop",
    "db:status": "pwsh -NoProfile -File backend/scripts/postgres-local.ps1 -Action status",
    "db:migrate": "node backend/scripts/migrate.cjs",
    "test:db": "node --require ./backend/config.cjs --test tests/database.test.cjs"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "supertest": "^7.3.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  }
}
